# ─────────────────────────────────────────────────────────────────────────────
# Canchas SaaS — variables de entorno (EJEMPLO, sin valores reales)
# Copiá este archivo a `.env` y completá los valores. `.env` está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: development | test | production
NODE_ENV=development

# ── Base de datos ────────────────────────────────────────────────────────────
# DOS roles distintos a propósito (defensa en profundidad / RLS real):
#
#   DATABASE_URL      → rol ADMIN/owner. SOLO migraciones (DDL, crear roles, RLS).
#                       Nunca lo usa el runtime de la app.
#   APP_DATABASE_URL  → rol app_user: NO-owner, SIN BYPASSRLS. Lo usa la app en
#                       runtime, por eso RLS se aplica de verdad.
#
# Local con el docker-compose incluido (Postgres en localhost:5432):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/canchas
APP_DATABASE_URL=postgres://app_user:app_user_password@localhost:5432/canchas
# `pnpm db:migrate` crea/actualiza el rol app_user tomando usuario y contraseña
# directamente de APP_DATABASE_URL (fuente única).

# ── better-auth ──────────────────────────────────────────────────────────────
# Secreto para firmar sesiones/tokens. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=cambiame-por-un-secreto-de-32+caracteres
# URL base pública de la app.
BETTER_AUTH_URL=http://localhost:3000

# ── Cifrado de tokens de Mercado Pago (AES-256-GCM) ──────────────────────────
# Clave de 32 bytes en base64. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA la compartas ni la commitees. Si se rota, los tokens viejos no descifran.
MP_TOKEN_ENC_KEY=cambiame-por-32-bytes-en-base64

# ── Mercado Pago (marketplace / OAuth) ───────────────────────────────────────
# Credenciales de NUESTRA aplicación de marketplace, del panel de developers:
#   https://www.mercadopago.com.ar/developers  →  Tus integraciones → tu app
# Con ellas canjeamos el `code` del OAuth por los tokens de cada complejo.
# Usá las de PRUEBA en desarrollo y las de producción solo en prod.
MP_CLIENT_ID=cambiame-por-el-client-id-de-tu-app
MP_CLIENT_SECRET=cambiame-por-el-client-secret-de-tu-app

# Clave secreta del webhook (panel de MP → Webhooks → "Clave secreta").
# Con ella verificamos la firma HMAC-SHA256 de cada notificación de pago.
# Es la garantía de que un pago es real: sin esto no se acredita nada.
MP_WEBHOOK_SECRET=cambiame-por-la-clave-secreta-del-webhook

# Comisión de la plataforma, en % del total de cada reserva cobrada (0 a 100).
# Ej: 2.5 => Promethix retiene 2,5% y el resto va a la cuenta del complejo.
MP_MARKETPLACE_FEE_PERCENT=0

# URL pública HTTPS de la app. La usan el callback de OAuth y el webhook, así
# que MP tiene que poder alcanzarla. En local usá un túnel (ngrok, cloudflared)
# y cargá esa misma URL como redirect URI en el panel de MP.
APP_PUBLIC_URL=http://localhost:3000
