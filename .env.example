# ─────────────────────────────────────────────────────────────────────────────
# Canchas SaaS — variables de entorno (EJEMPLO, sin valores reales)
# Copiá este archivo a `.env` y completá los valores. `.env` está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: development | test | production
NODE_ENV=development

# ── Base de datos ────────────────────────────────────────────────────────────
# DOS roles distintos a propósito (defensa en profundidad / RLS real):
#
#   DATABASE_URL      → rol ADMIN/owner. SOLO migraciones (DDL, crear roles, RLS).
#                       Nunca lo usa el runtime de la app.
#   APP_DATABASE_URL  → rol app_user: NO-owner, SIN BYPASSRLS. Lo usa la app en
#                       runtime, por eso RLS se aplica de verdad.
#
# Local con el docker-compose incluido (Postgres en localhost:5432):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/canchas
APP_DATABASE_URL=postgres://app_user:app_user_password@localhost:5432/canchas
# `pnpm db:migrate` crea/actualiza el rol app_user tomando usuario y contraseña
# directamente de APP_DATABASE_URL (fuente única).

# ── better-auth ──────────────────────────────────────────────────────────────
# Secreto para firmar sesiones/tokens. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=cambiame-por-un-secreto-de-32+caracteres
# URL base pública de la app.
BETTER_AUTH_URL=http://localhost:3000

# ── Cifrado de tokens de Mercado Pago (AES-256-GCM) ──────────────────────────
# Clave de 32 bytes en base64. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA la compartas ni la commitees. Si se rota, los tokens viejos no descifran.
MP_TOKEN_ENC_KEY=cambiame-por-32-bytes-en-base64
